{
    "name": "kinetis/roadrunner-adapter",
    "description": "RoadRunner runtime adapter for Kinetis — speaks the PSR7Worker/Goridge protocol and converts to/from PSR-7, including multipart/form-data support.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Alon Noy"
        }
    ],
    "require": {
        "php": "^8.4",
        "kinetis/framework": "dev-main",
        "nyholm/psr7": "^1.8.2",
        "psr/http-message": "^2.0",
        "riverline/multipart-parser": "^2.2.2",
        "spiral/roadrunner-http": "^4.1",
        "spiral/roadrunner-worker": "^3.5"
    },
    "require-dev": {
        "infection/infection": "^0.35.0",
        "phpstan/phpstan": "^2.2.8",
        "phpunit/phpunit": "^12.5.33",
        "spiral/roadrunner-cli": "^2.6",
        "vimeo/psalm": "^6.16.1"
    },
    "autoload": {
        "psr-4": {
            "Kinetis\\RoadRunnerAdapter\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Kinetis\\RoadRunnerAdapter\\Tests\\": "tests/"
        }
    },
    "extra": {
        "kinetis": {}
    },
    "repositories": [
        {
            "type": "path",
            "url": "../framework"
        }
    ],
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "infection/extension-installer": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
